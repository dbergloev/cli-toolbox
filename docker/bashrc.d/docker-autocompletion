# Ensure official Docker completion is loaded first
if ! declare -f __start_docker >/dev/null; then
    source <(command docker completion bash)
fi

# Rename the original __start_docker()
if ! declare -f __start_docker_original >/dev/null; then
    eval "$(declare -f __start_docker | sed 's/__start_docker/__start_docker_original/')"
fi

# Extend Docker's completion dispatcher
__start_docker() {
  local cur prev words cword
  _init_completion || return

  # Add custom subcommands to top-level
  if [[ $cword -eq 1 ]]; then
    local custom_cmds="scan ls compile"
    local default_cmds="$(__docker_list_commands)"
    COMPREPLY=( $(compgen -W "$default_cmds $custom_cmds" -- "$cur") )
    return
  fi

  case "${words[1]}" in
    info|start|stop|restart)
      # Suggest running container names if argument expected
      if [[ $cword -eq 2 ]]; then
        COMPREPLY=( $(compgen -W "$(__docker_list_running_containers)" -- "$cur") )
      fi
      return
      ;;
    compile)
      if [[ $cword -eq 2 ]]; then
        local completions
        mapfile -t completions < <(__docker_list_container_defs)

        COMPREPLY=( $(compgen -W "${completions[*]}" -- "$cur") )

        # If any match ends with '@', disable trailing space
        for c in "${COMPREPLY[@]}"; do
          if [[ "$c" == *@ ]]; then
            compopt -o nospace
            break
          fi
        done
      fi
      return
      ;;
    scan|ls)
      # No further arguments
      return
      ;;
  esac

  # Fallback to official Docker logic
  __start_docker_original "$@"
}

# Helper: to list running container names
__docker_list_running_containers() {
  command docker ps --format '{{.Names}}'
}

# Helper: get original docker commands (optional, improves Tab UI)
__docker_list_commands() {
  command docker --help | awk '/Commands:/,/^$/ { if ($1 != "Commands:" && $1 != "") print $1 }'
}

# Helper: get all available container build names
__docker_list_container_defs() {
  local dir="/etc/docker/containers"
  [[ -d "$dir" ]] || return

  for f in "$dir"/*.container; do
    [[ -e "$f" ]] || continue
    basename "$f" .container
  done
}

