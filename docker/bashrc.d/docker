# Make docker print 'ps' better
function docker() {
    if [[ "$1" == "compile" ]]; then
        docker-compile "$2"
    
    elif [[ "$1" == "scan" ]]; then
        docker-scan
    
    elif [[ "$1" == "ls" ]]; then
        docker-ls
        
    elif [[ "$1" == "info" && -n "$2" && "${2:0:1}" != "-" ]]; then
        docker-info "$2"
        
    elif [[ "$1" == "start" ]]; then
        docker-start "$2"
        
    elif [[ "$1" == "stop" ]]; then
        docker-stop "$2"
        
    elif [[ "$1" == "restart" ]]; then
        docker-stop "$2"
        docker-start "$2"

    else
        command docker "$@"
    fi
}

