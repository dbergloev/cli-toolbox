#!/usr/bin/env bash
#
# Synchronized event monitoring of instance states for Incus. 
# 
# NOTE:
#   Because this is synchronized, scripts should be quick and avoid hanging.
#
set -euo pipefail

QUEUE="/run/incus-events.queue"

strip_quotes() {
    local v="$1"
    v="${v#\"}"   # remove leading quote if present
    v="${v%\"}"   # remove trailing quote if present
    printf '%s' "$v"
}

cleanup() {
    rm -f "$QUEUE"
}

trap cleanup EXIT

mkfifo "$QUEUE"

#
# Producer
#
{
    INST_NAME=""
    INST_NAME_PREV=""
    INST_ACTION=""

    while IFS= read -r line; do
        trimmed="${line#"${line%%[![:space:]]*}"}"

        #
        # Empty line means end-of-event
        #
        if [[ -z "$trimmed" ]]; then
            #
            # Ignore repeated empty lines
            #
            if [[ -z "$INST_NAME" || -z "$INST_ACTION" ]]; then
                continue
            fi

            printf '%s\t%s\t%s\n' \
                "$INST_ACTION" \
                "$INST_NAME" \
                "$INST_NAME_PREV"

            INST_NAME=""
            INST_NAME_PREV=""
            INST_ACTION=""

            continue
        fi

        case "$trimmed" in
            name:\ *)
                INST_NAME="$(strip_quotes "${trimmed#*: }")"
            ;;

            old_name:\ *)
                INST_NAME_PREV="$(strip_quotes "${trimmed#*: }")"
            ;;

            action:\ *)
                INST_ACTION="$(strip_quotes "${trimmed#*: }")"
            ;;
        esac

    done < <(incus monitor --type lifecycle)

} > "$QUEUE" &

#
# Consumer
#
LAST_EVENT=""

while IFS=$'\t' read -r action name old_name; do
    EVENT_KEY="${name}:${action}"

    #
    # Prevent duplicate notifications
    #
    [[ "$EVENT_KEY" == "$LAST_EVENT" ]] && continue
    LAST_EVENT="$EVENT_KEY"

    case "$action" in
        instance-started|instance-restarted)
            /etc/rc.cron "incus:started:${name}"
        ;;

        instance-shutdown|instance-stopped)
            /etc/rc.cron "incus:stopped:${name}"
        ;;

        instance-created)
            /etc/rc.cron "incus:created:${name}"
        ;;

        instance-deleted)
            /etc/rc.cron "incus:deleted:${name}"
        ;;

        instance-renamed)
            /etc/rc.cron "incus:renamed:${old_name}:${name}"
        ;;
    esac

done < "$QUEUE"
